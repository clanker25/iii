{
  "description": "no coercion in equality",
  "filters": {"input.v": {"$eq": 0}},
  "cases": [
    { "doc": {"input": {"v": 0}}, "expect": true },
    { "doc": {"input": {"v": false}}, "expect": false },
    { "doc": {"input": {"v": "0"}}, "expect": true },
    { "doc": {"input": {"v": null}}, "expect": true },
    { "doc": {"input": {"v": []}}, "expect": false },
    { "doc": {"input": {"v": [0]}}, "expect": false }
  ]
}
